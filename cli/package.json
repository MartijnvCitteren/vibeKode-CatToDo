{
  "name": "todo-cat-cli",
  "version": "0.1.0",
  "private": true,
  "description": "The todo-cat command-line client, a client of the todo-cat REST API",
  "type": "module",
  "bin": {
    "todo-cat": "bin/todo-cat.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/todo-cat.js --log-level=warning",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@todo-cat/contract": "0.1.0",
    "better-auth": "1.7.7",
    "commander": "15.0.0",
    "esbuild": "0.28.2",
    "zod": "4.6.5"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  }
}
