{
  "name": "todo-cat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "next typegen && tsc --noEmit && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "qa": "bash scripts/qa.sh",
    "auth:generate": "auth generate --config scripts/auth-cli.config.mts --output lib/auth-schema.ts --yes && biome check --write lib/auth-schema.ts",
    "db:generate": "drizzle-kit generate && biome format --write drizzle",
    "db:migrate": "drizzle-kit migrate",
    "db:reset": "node scripts/db-reset.mts && drizzle-kit migrate",
    "db:seed": "tsx --conditions=react-server scripts/db-seed.mts",
    "openapi": "tsx scripts/openapi.mts && biome format --write contract/openapi.json"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "@libsql/client": "0.18.0",
    "@todo-cat/contract": "0.1.0",
    "better-auth": "1.7.7",
    "drizzle-orm": "1.0.0-rc.4",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@next/env": "16.3.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "auth": "1.7.7",
    "drizzle-kit": "1.0.0-rc.4",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "workspaces": [
    "contract",
    "cli"
  ]
}
